        "spec": {
          "id": 8,
          "title": "All active alert cities",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "bflo96hz3t5hcc"
                      },
                      "spec": {
                        "dataset": "",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\n    SELECT DISTINCT ON (city)\n        city,\n        status,\n        alert,\n        consumed_at\n    FROM weather_readings\n    ORDER BY city, consumed_at DESC\n)\nSELECT\n    COALESCE(\n        STRING_AGG(city || ': ' || alert, ' | '),\n        'NO ACTIVE ALERTS'\n    ) AS active_alerts\nFROM latest\nWHERE status = 'ALERT'\n  AND alert IS NOT NULL\n  AND alert <> ''\n  AND consumed_at >= NOW() - INTERVAL '5 minutes';",
