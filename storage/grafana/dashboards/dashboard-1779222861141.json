                      "spec": {
                        "dataset": "weather_db",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH latest AS (\n    SELECT DISTINCT ON (city)\n        city,\n        temperature,\n        humidity,\n        wind_speed,\n        rain,\n        status,\n        alert,\n        consumed_at\n    FROM weather_readings\n    ORDER BY city, consumed_at DESC\n)\nSELECT\n    city,\n    temperature,\n    humidity,\n    wind_speed,\n    rain,\n    status,\n    alert,\n    consumed_at,\n\n    CASE city\n        WHEN 'Haifa' THEN 32.7940\n        WHEN 'Tel Aviv' THEN 32.0853\n        WHEN 'Jerusalem' THEN 31.7683\n        WHEN 'Beer Sheva' THEN 31.2529\n        WHEN 'Eilat' THEN 29.5577\n        WHEN 'Tiberias' THEN 32.7959\n        WHEN 'Nazareth' THEN 32.6996\n        WHEN 'Ashdod' THEN 31.8044\n    END AS latitude,\n\n    CASE city\n        WHEN 'Haifa' THEN 34.9896\n        WHEN 'Tel Aviv' THEN 34.7818\n        WHEN 'Jerusalem' THEN 35.2137\n        WHEN 'Beer Sheva' THEN 34.7915\n        WHEN 'Eilat' THEN 34.9519\n        WHEN 'Tiberias' THEN 35.5310\n        WHEN 'Nazareth' THEN 35.3035\n        WHEN 'Ashdod' THEN 34.6553\n    END AS longitude\nFROM latest;",
                        "sql": {
